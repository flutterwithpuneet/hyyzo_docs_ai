# ============================================================
# Environment Variables - hyyzo_docs_ai
# Copy this file to .env and fill in your values.
# ============================================================

# --- OpenAI (optional, for LLM-powered answers) ---
OPENAI_API_KEY=your-openai-api-key-here

# --- Embedding Model ---
# Local HuggingFace model (runs offline, no API key needed)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- LLM Settings ---
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Document Settings ---
DOCS_DIRECTORY=docs
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Index Storage ---
INDEX_PERSIST_DIR=data/processed/embeddings

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
